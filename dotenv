### ORM

MIKRO_ORM_TYPE = postgresql
MIKRO_ORM_DB_NAME = ${DB_NAME}
MIKRO_ORM_USER = ${DB_USERNAME}
MIKRO_ORM_PASSWORD = ${DB_PASSWORD}
MIKRO_ORM_ENTITIES = ./dist/database/entity/*.entity.js
MIKRO_ORM_ENTITIES_TS = ./src/database/entity/*.entity.ts
MIKRO_ORM_MIGRATIONS_TABLE_NAME = migrations
MIKRO_ORM_MIGRATIONS_PATH = ./dist/database/migration
MIKRO_ORM_MIGRATIONS_PATH_TS = ./src/database/migration
MIKRO_ORM_SEEDER_PATH = ./dist/database/seed
MIKRO_ORM_SEEDER_PATH_TS = ./src/database/seed
MIKRO_ORM_MIGRATIONS_SNAPSHOT = false

